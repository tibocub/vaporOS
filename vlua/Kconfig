config VAPOROS_VLUA
	tristate "vlua -- vaporOS's own Lua API host (print/read basics)"
	depends on INTERPRETERS_LUA
	default n
	---help---
		A small program that creates its own Lua state and exposes a
		"vapor" table (vapor.print, vapor.read) to Lua scripts -- the
		first slice of the ComputerCraft-style high-level API. Reuses
		NuttX's own Lua interpreter sources (enable INTERPRETERS_LUA
		first), doesn't bundle a second copy of Lua.

if VAPOROS_VLUA

config VAPOROS_VLUA_PROGNAME
	string "Program name"
	default "vlua"

config VAPOROS_VLUA_PRIORITY
	int "priority"
	default 100

config VAPOROS_VLUA_STACKSIZE
	int "stack size"
	default DEFAULT_TASK_STACKSIZE

menu "Lua C libraries (sources live next to this repo, see setup.sh)"

config VAPOROS_VLUA_LFS
	bool "lfs -- LuaFileSystem (../luafilesystem)"
	default n
	---help---
		require("lfs"): attributes, dir, mkdir, rmdir, touch, setmode...
		lfs.symlinkattributes and lfs.lock_dir need symlinks/readlink, which
		most NuttX filesystems lack; they return nil, err there.

config VAPOROS_VLUA_LPEG
	bool "lpeg -- parsing expression grammars (../lpeg-1.1.0)"
	default n
	---help---
		require("lpeg"). Pure ANSI C. re.lua (lpeg's regex-like layer) is
		plain Lua, install it with the other pure-Lua libraries.

config VAPOROS_VLUA_LPEG_MAXRULES
	int "lpeg: maximum rules per grammar (MAXRULES)"
	depends on VAPOROS_VLUA_LPEG
	default 1000
	---help---
		lpeg's left-recursion check recurses once per rule step, up to this
		many levels, at about 40 bytes of C stack each on a Cortex-M0+. 1000
		(upstream) needs ~45 KB, more than a small vlua stack has, and a
		left-recursive grammar then overflows it and resets the board. Keep
		it below about (vlua stack size - 10 KB) / 45. Also the most rules
		a grammar may have.

config VAPOROS_VLUA_CJSON
	bool "cjson -- JSON encode/decode (../lua-cjson)"
	default n
	---help---
		require("cjson"). About 8 KB of flash on the RP2040 (the bundled
		dtoa.c is not used; numbers go through libc snprintf/strtod).
		Like upstream, every decoded number is a Lua float.

endmenu

endif

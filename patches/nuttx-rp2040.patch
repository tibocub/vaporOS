diff --git a/boards/arm/rp2040/waveshare-rp2040-zero/src/rp2040_crashdump.c b/boards/arm/rp2040/waveshare-rp2040-zero/src/rp2040_crashdump.c
new file mode 100644
index 0000000000..0c1b505940
--- /dev/null
+++ b/boards/arm/rp2040/waveshare-rp2040-zero/src/rp2040_crashdump.c
@@ -0,0 +1,83 @@
+/****************************************************************************
+ * boards/arm/rp2040/waveshare-rp2040-zero/src/rp2040_crashdump.c
+ *
+ * vaporOS: the Zero has no UART/debug probe wired up, so after a crash
+ * there is nothing to look at. Record what happened in the top 256 bytes of
+ * SRAM (reserved by lowering CONFIG_RAM_SIZE, so the heap never touches it);
+ * it survives the reset triggered by CONFIG_BOARD_RESET_ON_ASSERT and can be
+ * read back from NSH with:  xd 0x2003ff00 256
+ *
+ * Layout (32-bit words):
+ *   [0]  magic 0xC8A5D00D       [1] pc    [2] lr   [3] sp   [4] xpsr
+ *   [5]  r0 [6] r1 [7] r2 [8] r3 [9] r12
+ *   [10] fault-time stack pointer   [11] line number
+ *   [12] stack_base [13] stack_size
+ *   [16..31] task name (NUL-terminated, 16 bytes) / file (32) / msg (32)
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <nuttx/board.h>
+#include <nuttx/sched.h>
+#include <arch/irq.h>
+#include <stdint.h>
+#include <string.h>
+
+#ifdef CONFIG_BOARD_CRASHDUMP_CUSTOM
+
+#define CRASH_ADDR 0x2003ff00
+
+struct vapor_crash_s
+{
+  uint32_t magic;
+  uint32_t pc, lr, sp, xpsr;
+  uint32_t r0, r1, r2, r3, r12;
+  uint32_t cur_sp;
+  uint32_t line;
+  uint32_t stack_base, stack_size;
+  uint32_t pad[2];
+  char name[16];
+  char file[32];
+  char msg[32];
+};
+
+void board_crashdump(uintptr_t sp, FAR struct tcb_s *tcb,
+                     FAR const char *filename, int lineno,
+                     FAR const char *msg, FAR void *regs)
+{
+  volatile struct vapor_crash_s *c = (volatile struct vapor_crash_s *)
+                                     CRASH_ADDR;
+  uint32_t *r = (uint32_t *)regs;
+  unsigned i;
+
+  memset((void *)c, 0, sizeof(*c));
+  if (r != NULL)
+    {
+      c->pc = r[REG_PC];  c->lr = r[REG_LR]; c->sp = r[REG_SP];
+      c->xpsr = r[REG_XPSR];
+      c->r0 = r[REG_R0]; c->r1 = r[REG_R1]; c->r2 = r[REG_R2];
+      c->r3 = r[REG_R3]; c->r12 = r[REG_R12];
+    }
+
+  c->cur_sp = sp;
+  c->line   = lineno;
+  if (tcb != NULL)
+    {
+      c->stack_base = (uint32_t)(uintptr_t)tcb->stack_base_ptr;
+      c->stack_size = tcb->adj_stack_size;
+      for (i = 0; i < 15 && tcb->name[i]; i++) c->name[i] = tcb->name[i];
+    }
+
+  if (filename != NULL)
+    {
+      for (i = 0; i < 31 && filename[i]; i++) c->file[i] = filename[i];
+    }
+
+  if (msg != NULL)
+    {
+      for (i = 0; i < 31 && msg[i]; i++) c->msg[i] = msg[i];
+    }
+
+  c->magic = 0xc8a5d00d;
+}
+
+#endif

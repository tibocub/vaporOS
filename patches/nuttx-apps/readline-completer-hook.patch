  ****************************************************************************/
 
 #ifdef CONFIG_READLINE_TABCOMPLETION
+/* vaporOS: application-defined completion, see readline_completer() */
+
+struct completer_ctx_s
+{
+  FAR struct rl_common_s *vtbl;
+  FAR char *out;                /* output is gathered and written at once */
+  size_t len;
+  size_t cap;
+  int count;
+};
+
+static void completer_put(FAR struct completer_ctx_s *c, char ch)
+{
+  if (c->len + 1 > c->cap)
+    {
+      size_t ncap = c->cap == 0 ? 256 : c->cap * 2;
+      FAR char *p = realloc(c->out, ncap);
+
+      if (p == NULL)
+        {
+          return;
+        }
+
+      c->out = p;
+      c->cap = ncap;
+    }
+
+  c->out[c->len++] = ch;
+}
+
+static void completer_puts(FAR struct completer_ctx_s *c, FAR const char *s)
+{
+  while (*s != '\0')
+    {
+      completer_put(c, *s++);
+    }
+}
+
+static void completer_list(FAR void *arg, FAR const char *name)
+{
+  FAR struct completer_ctx_s *c = arg;
+
+  if (c->count++ == 0)
+    {
+      completer_put(c, '\n');
+    }
+
+  completer_puts(c, "  ");
+  completer_puts(c, name);
+  completer_put(c, '\n');
+}
+
+static void custom_completion(FAR struct rl_common_s *vtbl, char *buf,
+                              int buflen, int *nch)
+{
+  struct completer_ctx_s ctx;
+  char ins[96];
+  int n;
+  int i;
+  int inslen;
+
+  memset(&ctx, 0, sizeof(ctx));
+  ctx.vtbl = vtbl;
+  ins[0]   = '\0';
+  buf[*nch] = '\0';
+
+  n = g_completer(buf, *nch, ins, sizeof(ins), completer_list, &ctx);
+  if (n <= 0)
+    {
+      free(ctx.out);
+      return;
+    }
+
+  inslen = strlen(ins);
+  if (*nch + inslen + 1 > buflen)
+    {
+      inslen = buflen - *nch - 1;
+    }
+
+  if (inslen < 0)
+    {
+      inslen = 0;
+    }
+
+  memcpy(buf + *nch, ins, inslen);
+  buf[*nch + inslen] = '\0';
+
+  if (ctx.count > 0)
+    {
+      /* The candidate list scrolled the line away: redraw prompt + line */
+
+      if (g_readline_prompt != NULL)
+        {
+          completer_puts(&ctx, g_readline_prompt);
+        }
+
+      for (i = 0; i < *nch; i++)
+        {
+          completer_put(&ctx, buf[i]);
+        }
+    }
+
+  for (i = 0; i < inslen; i++)
+    {
+      completer_put(&ctx, buf[*nch + i]);
+    }
+
+  /* One write: the USB console wedges under bursts of one-byte writes. */
+
+  if (ctx.len > 0)
+    {
+      RL_WRITE(vtbl, ctx.out, ctx.len);
+    }
+
+  free(ctx.out);
+  *nch += inslen;
+}
+
 static void tab_completion(FAR struct rl_common_s *vtbl, char *buf,
                            int buflen, int *nch)
 {
@@ -174,6 +295,12 @@ static void tab_completion(FAR struct rl_common_s *vtbl, char *buf,
   int i;
   int j;
 
+  if (g_completer != NULL)
+    {
+      custom_completion(vtbl, buf, buflen, nch);
+      return;
+    }
+
   if (len >= 1)
     {
 #ifdef CONFIG_BUILTIN
@@ -406,6 +533,16 @@ FAR const char *readline_prompt(FAR const char *prompt)
 }
 #endif
 
+
+#ifdef CONFIG_READLINE_TABCOMPLETION
+readline_completer_f readline_completer(readline_completer_f fn)
+{
+  readline_completer_f ret = g_completer;
+  g_completer = fn;
+  return ret;
+}
+#endif

 #include <string.h>
 #include <ctype.h>
 #include <errno.h>
@@ -81,6 +82,8 @@ static FAR const char *g_readline_prompt = NULL;
 #ifdef CONFIG_READLINE_HAVE_EXTMATCH
 static FAR const struct extmatch_vtable_s *g_extmatch_vtbl = NULL;

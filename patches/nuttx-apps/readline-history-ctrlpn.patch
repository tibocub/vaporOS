+#ifdef CONFIG_READLINE_CMD_HISTORY
+/****************************************************************************
+ * Name: readline_history_load
+ *
+ *   Populate the in-memory command history from a file previously
+ *   written by readline_history_save() -- one command per line, oldest
+ *   first. Existing history is not cleared first, so this can also be
+ *   used to merge a second file in; call it once, before the first
+ *   readline() call, for the normal "load saved history at startup"
+ *   case.
+ *
+ *   The in-memory history this reads into (g_cmdhist) has no public
+ *   accessor otherwise -- it's file-private to this translation unit --
+ *   so an application has no way to load saved history without this
+ *   function existing.
+ *
+ * Input Parameters:
+ *   path - Path to the history file to read.
+ *
+ * Returned values:
+ *   OK on success. A missing file is not an error (returns OK, matching
+ *   "no history yet" as a normal, expected condition, e.g. on first
+ *   boot before any history file has ever been written) -- only a
+ *   genuine open failure for another reason returns a negated errno
+ *   value.
+ *
+ ****************************************************************************/
+
+int readline_history_load(FAR const char *path)
+{
+  FAR FILE *stream;
+  char line[RL_CMDHIST_LINELEN];
+
+  stream = fopen(path, "r");
+  if (stream == NULL)
+    {
+      return errno == ENOENT ? OK : -errno;
+    }
+
+  while (fgets(line, sizeof(line), stream) != NULL)
+    {
+      int nch = strlen(line);
+
+      if (nch > 0 && line[nch - 1] == '\n')
+        {
+          line[--nch] = '\0';
+        }
+
+      if (nch > 0)
+        {
+          history_push(line, nch);
+        }
+    }
+
+  fclose(stream);
+  return OK;
+}
+
+/****************************************************************************
+ * Name: readline_history_save
+ *
+ *   Write the in-memory command history out to a file, oldest entry
+ *   first, one command per line -- the format readline_history_load()
+ *   expects. Meant to be called once, on a clean application exit;
+ *   there's no automatic periodic save, so a crash or power loss loses
+ *   whatever history hasn't been explicitly saved yet.
+ *
+ * Input Parameters:
+ *   path - Path to the history file to write (created if it doesn't
+ *          exist, truncated if it does).
+ *
+ * Returned values:
+ *   OK on success, a negated errno value on failure (e.g. -ENOENT if
+ *   the containing directory doesn't exist -- this function does not
+ *   create it).
+ *
+ ****************************************************************************/
+
+int readline_history_save(FAR const char *path)
+{
+  FAR FILE *stream;
+  int i;
+
+  stream = fopen(path, "w");
+  if (stream == NULL)
+    {
+      return -errno;
+    }
+
+  for (i = 0; i < g_cmdhist.len; i++)
+    {
+      /* Oldest entry first: with g_cmdhist.len valid entries and 'head'
+       * the most recent, the oldest is 'len - 1' slots before head,
+       * same wraparound the rest of this file already uses.
+       */
+
+      int idx = g_cmdhist.head - (g_cmdhist.len - 1) + i;
+
+      if (idx < 0)
+        {
+          idx += RL_CMDHIST_LEN;
+        }
+
+      fprintf(stream, "%s\n", g_cmdhist.buf[idx]);
+    }
+
+  fclose(stream);
+  return OK;
+}
+#endif /* CONFIG_READLINE_CMD_HISTORY */
+

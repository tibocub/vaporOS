+#ifdef CONFIG_READLINE_CMD_HISTORY
+/****************************************************************************
+ * Name: history_push
+ *
+ * Description:
+ *   Push one line onto the circular history buffer, unless it's a
+ *   duplicate of the most recent entry -- the exact logic submit_line()
+ *   always ran on Enter, extracted unchanged so readline_history_load()
+ *   can reuse it too (loading a saved history file is "push every saved
+ *   line, in the order saved," the same operation).
+ *
+ ****************************************************************************/
+
+static void history_push(FAR const char *line, int nch)
+{
+  int i;
+
+  if (strncmp(line, g_cmdhist.buf[g_cmdhist.head], nch + 1) != 0)
+    {
+      g_cmdhist.head = (g_cmdhist.head + 1) % RL_CMDHIST_LEN;
+
+      for (i = 0; (i < nch) && i < (RL_CMDHIST_LINELEN - 1); i++)
+        {
+          g_cmdhist.buf[g_cmdhist.head][i] = line[i];
+        }
+
+      g_cmdhist.buf[g_cmdhist.head][i] = '\0';
+
+      if (g_cmdhist.len < RL_CMDHIST_LEN)
+        {
+          g_cmdhist.len++;
+        }
+    }
+}
+
+#  ifdef CONFIG_READLINE_EDIT_EMACS
+/****************************************************************************
+ * Name: history_navigate
+ *
+ * Description:
+ *   Move g_cmdhist.offset by one step (older or newer) and replace the
+ *   line's content with whatever history entry is now at that offset
+ *   (or the empty "not browsing history" line, once back at the most
+ *   recent position). Only reachable via Ctrl+P/Ctrl+N -- the up/down
+ *   arrow keys have their own, separate copy of this same logic
+ *   further down, predating this helper's own extraction; unifying the
+ *   two is a reasonable future cleanup, not required for this to work.
+ *
+ ****************************************************************************/
+
+static void history_navigate(FAR struct rl_common_s *vtbl, FAR char *buf,
+                              int buflen, FAR int *pnch, FAR int *pcursor,
+                              bool older)
+{
+  int nch = 0;
+  int i;
+
+  if (older)
+    {
+      /* Go to the past command in history */
+
+      g_cmdhist.offset--;
+
+      if (-g_cmdhist.offset >= g_cmdhist.len)
+        {
+          g_cmdhist.offset = -(g_cmdhist.len - 1);
+        }
+    }
+  else
+    {
+      /* Go to the recent command in history */
+
+      g_cmdhist.offset++;
+
+      if (g_cmdhist.offset > 1)
+        {
+          g_cmdhist.offset = 1;
+        }
+    }
+
+  if (g_cmdhist.offset != 1)
+    {
+      int idx = g_cmdhist.head + g_cmdhist.offset;
+
+      /* Circular buffer wrap around */
+
+      if (idx < 0)
+        {
+          idx = idx + RL_CMDHIST_LEN;
+        }
+      else if (idx >= RL_CMDHIST_LEN)
+        {
+          idx = idx - RL_CMDHIST_LEN;
+        }
+
+      for (i = 0;
+           g_cmdhist.buf[idx][i] != '\0' && nch + 1 < buflen;
+           i++)
+        {
+          buf[nch++] = g_cmdhist.buf[idx][i];
+        }
+
+      buf[nch] = '\0';
+    }
+
+  *pnch = nch;
+  *pcursor = nch;
+  redraw_line(vtbl, buf, nch, nch);
+}
+#  endif /* CONFIG_READLINE_EDIT_EMACS */
+#endif /* CONFIG_READLINE_CMD_HISTORY */
+

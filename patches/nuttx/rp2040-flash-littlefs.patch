vaporOS NuttX patch: rp2040-flash-littlefs

Problem:   The only on-flash filesystem option (SmartFS) lives inside the
           firmware image's flash region, so reflashing erases the user's files,
           and there is no way to pick the region.
Evidence:  vaporOS wants files (scripts, Lua programs) to survive firmware updates.
Fix:       CONFIG_RP2040_FLASH_LITTLEFS: an MTD over a *fixed* flash window
           (CONFIG_RP2040_FLASH_FS_OFFSET, length from RP2040_FLASH_LENGTH)
           registered as /dev/flash and mounted with LittleFS (autoformat) at
           CONFIG_RP2040_FLASH_MOUNT_POINT. Firmware must end below the offset.
Upstream:  MAYBE. Useful, but overlaps the existing SmartFS/ROMFS
           options; upstream would likely want it folded into one flash-fs
           configuration rather than a third one.

Apply: git -C ../nuttx apply ../vaporOS/patches/nuttx/rp2040-flash-littlefs.patch   (setup.sh does this)

diff --git a/arch/arm/src/rp2040/CMakeLists.txt b/arch/arm/src/rp2040/CMakeLists.txt
index 5b8b5f5102..d63903dcbd 100644
--- a/arch/arm/src/rp2040/CMakeLists.txt
+++ b/arch/arm/src/rp2040/CMakeLists.txt
@@ -92,6 +92,10 @@ if(CONFIG_RP2040_FLASH_FILE_SYSTEM)
   list(APPEND SRCS rp2040_flash_mtd.c rp2040_flash_initialize.S)
 endif()
 
+if(CONFIG_RP2040_FLASH_LITTLEFS)
+  list(APPEND SRCS rp2040_flash_mtd.c)
+endif()
+
 if(CONFIG_RP2040_FLASH_BOOT)
 
   # Set the Pico SDK path using the environment variable
diff --git a/arch/arm/src/rp2040/Kconfig b/arch/arm/src/rp2040/Kconfig
index 0b8f363195..e2172f4572 100644
--- a/arch/arm/src/rp2040/Kconfig
+++ b/arch/arm/src/rp2040/Kconfig
@@ -887,6 +887,33 @@ config RP2040_BOARD_HAS_WS2812
 #  Flash File System Configuration
 #####################################################################
 
+config RP2040_FLASH_LITTLEFS
+	bool "LittleFS on a fixed region of flash (vaporOS)"
+	default n
+	depends on !RP2040_FLASH_FILE_SYSTEM
+	select MTD
+	select FS_LITTLEFS
+	---help---
+		Mounts a LittleFS filesystem on the flash from
+		RP2040_FLASH_FS_OFFSET to the end of the chip. Unlike the SmartFS
+		option below, the region is not part of the firmware image, so it
+		keeps its contents when the firmware is reflashed (as long as the
+		firmware stays smaller than the offset).
+
+if RP2040_FLASH_LITTLEFS
+
+config RP2040_FLASH_FS_OFFSET
+	hex "Flash offset where the filesystem starts"
+	default 0x100000
+	---help---
+		Must be 4KiB aligned and past the end of the firmware image.
+
+config RP2040_FLASH_MOUNT_POINT
+	string "mount point for flash file system"
+	default "/flash"
+
+endif # RP2040_FLASH_LITTLEFS
+
 config RP2040_FLASH_FILE_SYSTEM
 	bool "Configure a read/write filesystem on unused flash memory"
 	default n
diff --git a/arch/arm/src/rp2040/Make.defs b/arch/arm/src/rp2040/Make.defs
index 2eeabede0b..acc8e5b826 100644
--- a/arch/arm/src/rp2040/Make.defs
+++ b/arch/arm/src/rp2040/Make.defs
@@ -97,6 +97,9 @@ ifeq ($(CONFIG_RP2040_FLASH_FILE_SYSTEM),y)
 CHIP_CSRCS += rp2040_flash_mtd.c
 CHIP_ASRCS += rp2040_flash_initialize.S
 endif
+ifeq ($(CONFIG_RP2040_FLASH_LITTLEFS),y)
+CHIP_CSRCS += rp2040_flash_mtd.c
+endif
 
 ifeq ($(CONFIG_RP2040_FLASH_BOOT),y)
 ifneq ($(PICO_SDK_PATH),)
diff --git a/arch/arm/src/rp2040/rp2040_flash_mtd.c b/arch/arm/src/rp2040/rp2040_flash_mtd.c
index 68bbb772b8..99a2041735 100644
--- a/arch/arm/src/rp2040/rp2040_flash_mtd.c
+++ b/arch/arm/src/rp2040/rp2040_flash_mtd.c
@@ -71,9 +71,20 @@
 #define FLASH_BLOCK_ERASE_CMD    0x20
 #define BOOT_2_SIZE              256
 
-#define FLASH_START_OFFSET (rp2040_smart_flash_start - (uint8_t *)XIP_BASE)
-#define FLASH_END_OFFSET   (rp2040_smart_flash_end   - (uint8_t *)XIP_BASE)
-#define FLASH_START_READ   (rp2040_smart_flash_start + 0x03000000)
+#ifdef CONFIG_RP2040_FLASH_LITTLEFS
+/* vaporOS: fixed region at CONFIG_RP2040_FLASH_FS_OFFSET, not part of the
+ * firmware image (no pre-formatted filesystem, no "2040" magic).
+ */
+
+#  define FLASH_START_OFFSET CONFIG_RP2040_FLASH_FS_OFFSET
+#  define FLASH_END_OFFSET   CONFIG_RP2040_FLASH_LENGTH
+#  define FLASH_START_READ   ((uint8_t *)XIP_NOCACHE_NOALLOC_BASE + \
+                              CONFIG_RP2040_FLASH_FS_OFFSET)
+#else
+#  define FLASH_START_OFFSET (rp2040_smart_flash_start - (uint8_t *)XIP_BASE)
+#  define FLASH_END_OFFSET   (rp2040_smart_flash_end   - (uint8_t *)XIP_BASE)
+#  define FLASH_START_READ   (rp2040_smart_flash_start + 0x03000000)
+#endif
 
 /* Note: There is some ambiguity in terminology when it comes to flash.
  *       Some call the chunk that can be erased a sector where others
@@ -166,8 +177,10 @@ static int     rp2040_flash_ioctl      (struct mtd_dev_s *dev,
  * Public Data
  ****************************************************************************/
 
+#ifndef CONFIG_RP2040_FLASH_LITTLEFS
 extern const uint8_t rp2040_smart_flash_start[256];
 extern const uint8_t rp2040_smart_flash_end[0];
+#endif
 
 /****************************************************************************
  * Private Data
@@ -742,6 +755,7 @@ struct mtd_dev_s *rp2040_flash_mtd_initialize(void)
 
   /* Do we need to initialize the flash? */
 
+#ifndef CONFIG_RP2040_FLASH_LITTLEFS
   if (memcmp(rp2040_smart_flash_start, "2040", 4) == 0)
     {
       uint8_t    buffer[FLASH_SECTOR_SIZE];
@@ -765,6 +779,7 @@ struct mtd_dev_s *rp2040_flash_mtd_initialize(void)
 
       leave_critical_section(flags);
     }
+#endif
 
   return &(my_dev.mtd_dev);
 }
diff --git a/boards/arm/rp2040/common/Kconfig b/boards/arm/rp2040/common/Kconfig
index cce9cc12db..07c1091e41 100644
--- a/boards/arm/rp2040/common/Kconfig
+++ b/boards/arm/rp2040/common/Kconfig
@@ -530,7 +530,7 @@ endif # RP2040_BOARD_HAS_WS2812
 #  FLASH File System Configuration
 #####################################################################
 
-if RP2040_FLASH_FILE_SYSTEM
+if RP2040_FLASH_FILE_SYSTEM || RP2040_FLASH_LITTLEFS
 
 config RP2040_FLASH_LENGTH
 	int "Size of flash memory in bytes."
@@ -538,7 +538,7 @@ config RP2040_FLASH_LENGTH
 	---help---
 		This is the overall amount of flash memory on the board.
 
-endif # RP2040_FLASH_FILE_SYSTEM
+endif # RP2040_FLASH_FILE_SYSTEM || RP2040_FLASH_LITTLEFS
 
 #####################################################################
 #  LCD Configuration
diff --git a/boards/arm/rp2040/common/src/rp2040_common_bringup.c b/boards/arm/rp2040/common/src/rp2040_common_bringup.c
index 140d488270..4a51fdd51c 100644
--- a/boards/arm/rp2040/common/src/rp2040_common_bringup.c
+++ b/boards/arm/rp2040/common/src/rp2040_common_bringup.c
@@ -130,7 +130,7 @@
 #  include <rp2040_romfsimg.h>
 #endif
 
-#ifdef CONFIG_RP2040_FLASH_FILE_SYSTEM
+#if defined(CONFIG_RP2040_FLASH_FILE_SYSTEM) || defined(CONFIG_RP2040_FLASH_LITTLEFS)
 #  include "rp2040_flash_mtd.h"
 #endif
 
@@ -152,7 +152,7 @@ int rp2040_common_bringup(void)
 {
   int ret = 0;
 
-#ifdef CONFIG_RP2040_FLASH_FILE_SYSTEM
+#if defined(CONFIG_RP2040_FLASH_FILE_SYSTEM) || defined(CONFIG_RP2040_FLASH_LITTLEFS)
   struct mtd_dev_s *mtd_dev;
 #endif
 
@@ -766,6 +766,36 @@ int rp2040_common_bringup(void)
 
 #endif
 
+#ifdef CONFIG_RP2040_FLASH_LITTLEFS
+  /* vaporOS: LittleFS on a fixed flash region; formatted on first mount
+   * (or if it is unreadable) via the "autoformat" option.
+   */
+
+  mtd_dev = rp2040_flash_mtd_initialize();
+  if (mtd_dev == NULL)
+    {
+      syslog(LOG_ERR, "ERROR: flash_mtd_initialize failed: %d\n", errno);
+    }
+  else
+    {
+      ret = register_mtddriver("/dev/flash", mtd_dev, 0755, NULL);
+      if (ret < 0)
+        {
+          syslog(LOG_ERR, "ERROR: register_mtddriver failed: %d\n", ret);
+        }
+      else
+        {
+          mkdir(CONFIG_RP2040_FLASH_MOUNT_POINT, 0777);
+          ret = nx_mount("/dev/flash", CONFIG_RP2040_FLASH_MOUNT_POINT,
+                         "littlefs", 0, "autoformat");
+          if (ret < 0)
+            {
+              syslog(LOG_ERR, "ERROR: littlefs mount failed: %d\n", ret);
+            }
+        }
+    }
+#endif
+
 #if defined(CONFIG_RP2040_ROMFS_ROMDISK_DEVNAME)
   /* Register the ROM disk */
 
